# Supabase — App Router cookie-based auth (@supabase/ssr)
# Use the NEW publishable / secret API keys (not legacy anon/service_role).
# Find these in: Supabase Dashboard → Project Settings → API Keys

# Your project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (safe to expose in the browser) — starts with "sb_publishable_..."
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Secret key (server-only, NEVER expose to the browser) — starts with "sb_secret_..."
# Used by server actions / route handlers that need elevated access.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
